# Email Commitment Tracker — NON-SECRET configuration only.
# Copy this file to `.env` (which is gitignored) and fill in your values.
#
# The IMAP PASSWORD is intentionally NOT stored here. It lives in the OS keyring.
# Set it once with:   python -m scripts.set_imap_password
# (For Gmail: enable 2-Step Verification and create an "App Password".)

# --- IMAP connection ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_MAILBOX=INBOX

# --- Fetch window ---
# How many days back to look, and the max number of emails to pull per cycle.
FETCH_LOOKBACK_DAYS=7
FETCH_MAX_EMAILS=50

# --- Local LLM (Ollama) ---
# Runs on your machine; email content never leaves the device.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=180
EXTRACTION_MAX_BODY_CHARS=6000
# Commitments the model reports below this confidence are discarded.
EXTRACTION_MIN_CONFIDENCE=0.3
