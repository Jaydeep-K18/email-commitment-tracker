# Email Commitment Tracker — NON-SECRET configuration only.
# Copy this file to `.env` (which is gitignored) and fill in your values.
#
# The IMAP PASSWORD is intentionally NOT stored here. It lives in the OS keyring.
# Set it once with:   python -m scripts.set_imap_password
# (For Gmail: enable 2-Step Verification and create an "App Password".)

# --- IMAP connection ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_MAILBOX=INBOX

# --- Fetch window ---
# How many days back to look, and the max number of emails to pull per cycle.
FETCH_LOOKBACK_DAYS=7
FETCH_MAX_EMAILS=50

# --- Local LLM (Ollama) ---
# Runs on your machine; email content never leaves the device.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=180
EXTRACTION_MAX_BODY_CHARS=6000
# Commitments the model reports below this confidence are discarded.
EXTRACTION_MIN_CONFIDENCE=0.3

# --- Calendar output ---
CALENDAR_NAME=Email Commitments
CALENDAR_REMINDER_MINUTES=30
CALENDAR_ALLDAY_REMINDER_HOURS=24
CALENDAR_REFRESH_MINUTES=60

# --- Local calendar server ---
# 127.0.0.1 keeps the feed off the network entirely. Change only if you
# deliberately want other devices on your LAN to reach it.
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# ===========================================================================
# Full-stack app (v2)
# ===========================================================================
# These hold passwords, so the real values go in `.env` (gitignored), never here.
# Generate each password with:   python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- PostgreSQL (docker compose) ---
POSTGRES_PASSWORD=change-me
# Shared by the Python worker and the Node server. Either scheme works:
# postgres:// is rewritten for SQLAlchemy automatically.
DATABASE_URL=postgres://commitmail:change-me@127.0.0.1:5432/commitmail

# --- Redis (docker compose) ---
REDIS_PASSWORD=change-me-too
REDIS_URL=redis://:change-me-too@127.0.0.1:6379/0
