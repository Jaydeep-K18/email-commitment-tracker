# Email Commitment Tracker — NON-SECRET configuration only.
# Copy this file to `.env` (which is gitignored) and fill in your values.
#
# The IMAP PASSWORD is intentionally NOT stored here. It lives in the OS keyring.
# Set it once with:   python -m scripts.set_imap_password
# (For Gmail: enable 2-Step Verification and create an "App Password".)

# --- IMAP connection ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_MAILBOX=INBOX

# --- Fetch window ---
# How many days back to look, and the max number of emails to pull per cycle.
FETCH_LOOKBACK_DAYS=7
FETCH_MAX_EMAILS=50

# --- Local LLM (Ollama) ---
# Runs on your machine; email content never leaves the device.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=180
EXTRACTION_MAX_BODY_CHARS=6000
# Commitments the model reports below this confidence are discarded.
EXTRACTION_MIN_CONFIDENCE=0.3

# --- Calendar output ---
CALENDAR_NAME=Email Commitments
CALENDAR_REMINDER_MINUTES=30
CALENDAR_ALLDAY_REMINDER_HOURS=24
CALENDAR_REFRESH_MINUTES=60

# --- The worker's own endpoints ---
# The .ics feed, the Gmail panel's endpoints and the internal setup API. Only
# the CommitMail server talks to these (it relays /calendar.ics and /ext/*), so
# keep them on loopback.
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# ===========================================================================
# Full-stack app (v2)
# ===========================================================================
# These hold passwords, so the real values go in `.env` (gitignored), never here.
# Generate each password with:   python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- PostgreSQL (docker compose) ---
POSTGRES_PASSWORD=change-me
# Host port for Postgres. Change it (and the port in DATABASE_URL) if something
# else already listens on 5432.
# POSTGRES_PORT=5432
# Shared by the Python worker and the Node server. Either scheme works:
# postgres:// is rewritten for SQLAlchemy automatically.
DATABASE_URL=postgres://commitmail:change-me@127.0.0.1:5432/commitmail

# --- Redis (docker compose) ---
REDIS_PASSWORD=change-me-too
REDIS_URL=redis://:change-me-too@127.0.0.1:6379/0

# --- Server <-> worker ---
# Shared secret the server sends when it asks the worker to do setup steps
# (test a mailbox, sign in with Google). Same value for both; generate as above.
INTERNAL_API_TOKEN=change-me-three

# --- The CommitMail server (Express) and the web dev server (Vite) ---
# The API listens on PORT; in development the React app runs on WEB_PORT and
# forwards to it. Both read these, so changing a port here is enough. Set
# WEB_DIST to have the API server serve a built app instead.
# PORT=4000
# WEB_PORT=5173
# WEB_DIST=apps/web/dist

# --- Kafka event streaming (optional) ---
# Start the broker with:   docker compose --profile events up -d
# Then set this for both the worker (its relay publishes every event) and the
# server (it streams them to the browser). Leave it unset to skip Kafka: the
# server then reads live events straight from Postgres, and nothing is lost.
# KAFKA_BROKERS=127.0.0.1:9092
# KAFKA_EVENTS_TOPIC=commitmail.events

# --- Flink metrics (optional) ---
# Start Kafka and Flink with:   docker compose --profile streaming up -d --build
# (the worker must have KAFKA_BROKERS set, so there are events to read). Then
# set this for the server, which reads the job's health from it. Without Flink
# the System page computes the same metrics from the database.
# FLINK_URL=http://127.0.0.1:8081
# FLINK_PORT=8081               # moves Flink's dashboard if 8081 is taken
