# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Local secrets & config
.env

# Local runtime data — NEVER commit email content, the database, or the calendar
data/
*.db
*.sqlite3
*.ics

# PyInstaller output (Phase 8). The .spec file is source and is committed; the
# 100MB+ executable it produces is a build artefact and is not.
build/
dist/
*.log

# OS cruft
.DS_Store
Thumbs.db

# Node / the full-stack app
node_modules/
apps/*/dist/
apps/*/dist-demo/
packages/*/dist/
coverage/
.vite/
playwright-report/
test-results/
*.tsbuildinfo

# Personal documents that happen to sit in this folder.
/*.pdf

# Local launch configs for the desktop app, with this machine's ports.
/.claude/launch.json
